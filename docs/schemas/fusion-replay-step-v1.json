{
  "$defs": {
    "FusionEvidence": {
      "additionalProperties": false,
      "description": "Composition supplies the registered session, host clock and play epoch.",
      "properties": {
        "clock_domain": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Clock Domain",
          "type": "string"
        },
        "match_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Match Id",
          "type": "string"
        },
        "observation": {
          "discriminator": {
            "mapping": {
              "sensor_impact": "#/$defs/SensorImpact",
              "vision_candidate": "#/$defs/VisionCandidate"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/VisionCandidate"
            },
            {
              "$ref": "#/$defs/SensorImpact"
            }
          ],
          "title": "Observation"
        },
        "play_epoch": {
          "minimum": 0,
          "title": "Play Epoch",
          "type": "integer"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "match_id",
        "clock_domain",
        "play_epoch",
        "observation"
      ],
      "title": "FusionEvidence",
      "type": "object"
    },
    "SensorImpact": {
      "additionalProperties": false,
      "properties": {
        "automatic_confirmation_allowed": {
          "const": false,
          "default": false,
          "title": "Automatic Confirmation Allowed",
          "type": "boolean"
        },
        "boot_id": {
          "title": "Boot Id",
          "type": "integer"
        },
        "classification": {
          "enum": [
            "net_impact",
            "frame_impact",
            "mixed_impact",
            "slow_impact",
            "unknown"
          ],
          "title": "Classification",
          "type": "string"
        },
        "configuration_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Configuration Version",
          "type": "string"
        },
        "device_id": {
          "title": "Device Id",
          "type": "integer"
        },
        "emitted_seconds": {
          "minimum": 0,
          "title": "Emitted Seconds",
          "type": "number"
        },
        "event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Event Id",
          "type": "string"
        },
        "evidence": {
          "enum": [
            "synthetic",
            "venue",
            "unverified"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "features": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Features",
          "type": "object"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "goal_end": {
          "enum": [
            "goal_a",
            "goal_b"
          ],
          "title": "Goal End",
          "type": "string"
        },
        "host_clock_domain": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Host Clock Domain",
          "type": "string"
        },
        "occurred_device_seconds": {
          "minimum": 0,
          "title": "Occurred Device Seconds",
          "type": "number"
        },
        "occurred_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Occurred Seconds"
        },
        "possible_goal": {
          "const": true,
          "default": true,
          "title": "Possible Goal",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "timing_uncertainty_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Timing Uncertainty Seconds"
        },
        "type": {
          "const": "sensor_impact",
          "default": "sensor_impact",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "goal_end",
        "device_id",
        "boot_id",
        "occurred_device_seconds",
        "occurred_seconds",
        "emitted_seconds",
        "timing_uncertainty_seconds",
        "host_clock_domain",
        "evidence",
        "classification",
        "features",
        "flags",
        "configuration_version"
      ],
      "title": "SensorImpact",
      "type": "object"
    },
    "VisionCandidate": {
      "additionalProperties": false,
      "properties": {
        "automatic_confirmation_allowed": {
          "const": false,
          "default": false,
          "title": "Automatic Confirmation Allowed",
          "type": "boolean"
        },
        "calibration_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Calibration Version",
          "type": "string"
        },
        "camera_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Camera Id",
          "type": "string"
        },
        "clip_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Path"
        },
        "configuration_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Configuration Version",
          "type": "string"
        },
        "crossing_interval_seconds": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crossing Interval Seconds"
        },
        "emitted_seconds": {
          "minimum": 0,
          "title": "Emitted Seconds",
          "type": "number"
        },
        "event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Event Id",
          "type": "string"
        },
        "evidence": {
          "enum": [
            "synthetic",
            "venue"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "goal_end": {
          "enum": [
            "goal_a",
            "goal_b"
          ],
          "title": "Goal End",
          "type": "string"
        },
        "match_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Match Id",
          "type": "string"
        },
        "model_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Model Version",
          "type": "string"
        },
        "occurred_seconds": {
          "minimum": 0,
          "title": "Occurred Seconds",
          "type": "number"
        },
        "quality": {
          "enum": [
            "observed_crossing",
            "predicted_crossing",
            "depth_ambiguous",
            "boundary_uncertain",
            "net_motion_only"
          ],
          "title": "Quality",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "requires_review": {
          "const": true,
          "default": true,
          "title": "Requires Review",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "supporting_sequences": {
          "items": {
            "type": "integer"
          },
          "title": "Supporting Sequences",
          "type": "array"
        },
        "timing_uncertainty_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Timing Uncertainty Seconds"
        },
        "track_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Track Id"
        },
        "type": {
          "const": "vision_candidate",
          "default": "vision_candidate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "session_id",
        "match_id",
        "camera_id",
        "goal_end",
        "track_id",
        "occurred_seconds",
        "emitted_seconds",
        "timing_uncertainty_seconds",
        "calibration_version",
        "model_version",
        "configuration_version",
        "quality",
        "evidence",
        "reasons",
        "flags",
        "supporting_sequences"
      ],
      "title": "VisionCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "enum": [
            "start",
            "pause",
            "resume",
            "end",
            "swap_ends",
            "restart",
            "confirm",
            "reject",
            "undo"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "at_seconds": {
      "minimum": 0,
      "title": "At Seconds",
      "type": "number"
    },
    "candidate_evidence_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Evidence Id"
    },
    "command_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Id"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/FusionEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "kind": {
      "enum": [
        "evidence",
        "command",
        "tick"
      ],
      "title": "Kind",
      "type": "string"
    }
  },
  "required": [
    "at_seconds",
    "kind"
  ],
  "title": "FusionReplayStep",
  "type": "object"
}
