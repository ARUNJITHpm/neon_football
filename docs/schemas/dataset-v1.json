{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "video",
            "frame_index",
            "recording_manifest",
            "replay_events",
            "vision_observations",
            "clip"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "kind"
      ],
      "title": "Asset",
      "type": "object"
    },
    "DatasetSession": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Assets",
          "type": "array"
        },
        "calibration_versions": {
          "patternProperties": {
            "^[a-zA-Z0-9_.:-]+$": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[a-zA-Z0-9_.:-]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Calibration Versions",
          "type": "object"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "configuration_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Configuration Version",
          "type": "string"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "evidence": {
          "enum": [
            "synthetic",
            "venue"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "host_clock_domain": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Host Clock Domain",
          "type": "string"
        },
        "matches": {
          "items": {
            "$ref": "#/$defs/MatchWindow"
          },
          "title": "Matches",
          "type": "array"
        },
        "model_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Model Version",
          "type": "string"
        },
        "physical_alignment_verified": {
          "default": false,
          "title": "Physical Alignment Verified",
          "type": "boolean"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "source_group_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Source Group Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "blind_test"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "source_group_id",
        "split",
        "evidence",
        "duration_seconds",
        "host_clock_domain",
        "configuration_version",
        "model_version",
        "matches",
        "assets"
      ],
      "title": "DatasetSession",
      "type": "object"
    },
    "MatchWindow": {
      "additionalProperties": false,
      "properties": {
        "active_auto_windows": {
          "items": {
            "$ref": "#/$defs/Window"
          },
          "title": "Active Auto Windows",
          "type": "array"
        },
        "end_seconds": {
          "minimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "match_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Match Id",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        }
      },
      "required": [
        "start_seconds",
        "end_seconds",
        "match_id"
      ],
      "title": "MatchWindow",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end_seconds": {
          "minimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        }
      },
      "required": [
        "start_seconds",
        "end_seconds"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotation_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Annotation Policy Version",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Dataset Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/DatasetSession"
      },
      "title": "Sessions",
      "type": "array"
    },
    "split_assignment_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Split Assignment Version",
      "type": "string"
    },
    "split_frozen_at": {
      "format": "date-time",
      "title": "Split Frozen At",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "annotation_policy_version",
    "split_assignment_version",
    "split_frozen_at",
    "sessions"
  ],
  "title": "DatasetManifest",
  "type": "object"
}
