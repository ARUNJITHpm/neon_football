{
  "additionalProperties": false,
  "properties": {
    "automatic_score_mutation_allowed": {
      "const": false,
      "default": false,
      "title": "Automatic Score Mutation Allowed",
      "type": "boolean"
    },
    "candidate_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Candidate Id",
      "type": "string"
    },
    "collect_until_seconds": {
      "minimum": 0,
      "title": "Collect Until Seconds",
      "type": "number"
    },
    "configuration_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Configuration Version",
      "type": "string"
    },
    "confirmation": {
      "anyOf": [
        {
          "enum": [
            "shadow_rule",
            "operator"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmation"
    },
    "confirmed_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed Seconds"
    },
    "corrected": {
      "default": false,
      "title": "Corrected",
      "type": "boolean"
    },
    "created_seconds": {
      "minimum": 0,
      "title": "Created Seconds",
      "type": "number"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "goal_end": {
      "enum": [
        "goal_a",
        "goal_b"
      ],
      "title": "Goal End",
      "type": "string"
    },
    "match_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Match Id",
      "type": "string"
    },
    "occurred_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Occurred Seconds"
    },
    "play_epoch": {
      "title": "Play Epoch",
      "type": "integer"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "review_until_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Until Seconds"
    },
    "rule_label": {
      "default": "collecting",
      "enum": [
        "collecting",
        "observed_and_corroborated",
        "review_required",
        "unresolved",
        "operator_decision"
      ],
      "title": "Rule Label",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "default": "COLLECTING",
      "enum": [
        "COLLECTING",
        "PENDING_REVIEW",
        "CONFIRMED",
        "REJECTED",
        "UNRESOLVED"
      ],
      "title": "Status",
      "type": "string"
    },
    "team": {
      "enum": [
        "orange",
        "green"
      ],
      "title": "Team",
      "type": "string"
    },
    "track_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Track Ids",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "session_id",
    "match_id",
    "play_epoch",
    "goal_end",
    "team",
    "occurred_seconds",
    "created_seconds",
    "collect_until_seconds",
    "configuration_version"
  ],
  "title": "FusedCandidate",
  "type": "object"
}
